                        "value": true
                    }
                },
                {
                    "id": "text_pause",
                    "element": "input",
                    "type": "text",
                    "label": "TRANSLATE.JUSTOLED.TEXT_PAUSE",
                    "doc": "TRANSLATE.JUSTOLED.TEXT_LINES_DOC",
                    "value": "Paused|waiting on music"
                },
                {
                    "id": "text_shutdown",
                    "element": "input",
                    "type": "text",
                    "label": "TRANSLATE.JUSTOLED.TEXT_SHUTDOWN",
                    "doc": "TRANSLATE.JUSTOLED.TEXT_LINES_DOC",
                    "value": "Volumio|shutting down",
                    "visibleIf": {
