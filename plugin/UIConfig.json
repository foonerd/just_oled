{
    "page": {
        "label": "TRANSLATE.JUSTOLED.PLUGIN_CONFIGURATION"
    },
    "sections": [
        {
            "id": "section_connection",
            "element": "section",
            "label": "TRANSLATE.JUSTOLED.SECTION_CONNECTION",
            "icon": "fa-plug",
            "description": "TRANSLATE.JUSTOLED.SECTION_CONNECTION_DOC",
