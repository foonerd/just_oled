                {
                    "id": "test",
                    "element": "button",
                    "label": "TRANSLATE.JUSTOLED.TEST",
                    "doc": "TRANSLATE.JUSTOLED.TEST_DOC",
                    "onClick": {
                        "type": "plugin",
                        "endpoint": "system_hardware/just_oled",
                        "method": "testDisplay",
