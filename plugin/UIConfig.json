                "type": "controller",
                "endpoint": "system_hardware/just_oled",
                "method": "saveConnection"
            },
            "saveButton": {
                "label": "TRANSLATE.JUSTOLED.SAVE",
                "data": [
                    "connection",
                    "panel",
                    "i2c_bus",
                    "i2c_sda",
                    "i2c_scl",
                    "i2c_address",
                    "spi_bus",
                    "spi_cs",
                    "gpio_dc",
                    "gpio_reset",
                    "rotate"
                ]
            },
            "content": [
                {
                    "id": "connection",
                    "element": "select",
                    "label": "TRANSLATE.JUSTOLED.CONNECTION",
                    "doc": "TRANSLATE.JUSTOLED.CONNECTION_DOC",
                    "value": {
                        "value": "i2c",
                        "label": "TRANSLATE.JUSTOLED.CONNECTION_I2C"
                    },
                    "options": [
                        {
                            "value": "i2c",
                            "label": "TRANSLATE.JUSTOLED.CONNECTION_I2C"
                        },
                        {
                            "value": "i2c_custom",
                            "label": "TRANSLATE.JUSTOLED.CONNECTION_I2C_CUSTOM"
                        },
                        {
                            "value": "spi",
                            "label": "TRANSLATE.JUSTOLED.CONNECTION_SPI"
                        },
                        {
                            "value": "spi_waveshare",
                            "label": "TRANSLATE.JUSTOLED.CONNECTION_SPI_WAVESHARE"
                        },
                        {
                            "value": "spi_custom",
                            "label": "TRANSLATE.JUSTOLED.CONNECTION_SPI_CUSTOM"
                        }
                    ]
