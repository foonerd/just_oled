                    "element": "input",
                    "type": "number",
                    "label": "TRANSLATE.JUSTOLED.GPIO_RESET",
                    "doc": "TRANSLATE.JUSTOLED.GPIO_RESET_DOC",
                    "value": 25,
                    "attributes": [
                        {
                            "min": 0
                        },
                        {
                            "max": 27
                        },
                        {
                            "step": 1
                        }
                    ],
                    "visibleIf": {
                        "field": "connection",
                        "value": "spi_custom"
