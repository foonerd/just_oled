        {
            "id": "section_messages",
            "element": "section",
            "label": "TRANSLATE.JUSTOLED.SECTION_MESSAGES",
            "icon": "fa-comment-o",
            "description": "TRANSLATE.JUSTOLED.SECTION_MESSAGES_DOC",
            "onSave": {
                "type": "controller",
                "endpoint": "system_hardware/just_oled",
                "method": "saveMessages"
            },
            "saveButton": {
                "label": "TRANSLATE.JUSTOLED.SAVE",
                "data": [
                    "show_lifecycle",
                    "text_boot",
                    "text_ready",
                    "text_pause",
                    "text_shutdown",
                    "text_reboot"
                ]
            },
            "content": [
                {
                    "id": "show_lifecycle",
                    "element": "switch",
                    "label": "TRANSLATE.JUSTOLED.SHOW_LIFECYCLE",
