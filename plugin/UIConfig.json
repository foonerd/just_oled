                },
                {
                    "id": "text_reboot",
                    "element": "input",
                    "type": "text",
                    "label": "TRANSLATE.JUSTOLED.TEXT_REBOOT",
                    "doc": "TRANSLATE.JUSTOLED.TEXT_LINES_DOC",
